# 本地回测不需要任何密钥。
# 以下变量仅为未来 MT5 Demo / 外部适配器预留，禁止把真实值提交到 Git。
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# MT5 demo order smoke test only. Keep false unless you intentionally run
# scripts/test_mt5_demo_order.py with --confirm-demo-order.
MT5_DEMO_ENABLED=false
MT5_MAGIC=26091701
MT5_DEVIATION=20

# A股 QMT/MiniQMT 预留。开户后由券商提供，当前不启用实盘。
QMT_ACCOUNT_ID=
QMT_PATH=

# 国内期货 CTP 预留。开户后由期货公司提供，当前不启用实盘。
CTP_BROKER_ID=
CTP_USER_ID=
CTP_PASSWORD=
CTP_APP_ID=
CTP_AUTH_CODE=
CTP_MD_FRONT=
CTP_TD_FRONT=

# 受信任的本地指标插件模块，多个模块用逗号分隔。
QUANT_PLUGIN_MODULES=

# Responsive computer/phone web terminal.
# Required when starting scripts/run_web.py with --host 0.0.0.0.
WEB_API_TOKEN=
WEB_MAX_VOLUME=0.01
WEB_SYMBOLS=EURUSD,XAUUSD

# 当前项目必须保持 false；本项目没有实盘 Broker 实现。
LIVE_TRADING_ENABLED=false
